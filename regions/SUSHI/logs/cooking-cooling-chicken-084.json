      "fields": [
        {
          "id": "cookingNote",
          "type": "note",
          "lines": [
            {
              "b": "Cooking — instructions:",
              "t": ""
            },
            "Heat-Treatment: QA personnel will insert pasteurization probe into thickest portion (coldest spot) of the meat.",
            "1. Take the time and temperature of the meat before and after it goes into the oven. Time at 147°F must be at least 10 min.",
            "2. Record the time and temperature at target temperature and hold time."
          ]
        },
        {
          "id": "coolingNote",
          "type": "note",
          "lines": [
            {
              "b": "Cooling — instructions:",
              "t": ""
            },
            "Stabilization: QA personnel will test the internal temperature of the thickest (warmest spot) piece using a thermapen and note the temperature once it comes out of the oven.",
            "1. Precooling: 10-15 min after cooking/heat treatment, record time and temperature. Temperature should be above 130°F.",
            "2. 1st Stage Cooling: Record time and temperature every 30 min × 3. Temperature needs to be below 80°F by 3rd check.",
            "3. 2nd Stage Cooling: Check time and temperature after 3 hrs from last check.",
            "Stabilization: Temperature from 130°F - 80°F in 1.5 hrs. 80°F - 40°F in 5 hrs."
          ]
        },
        {
          "id": "usda",
          "type": "info",
          "head": [
            "Item",
            "Time & Temp (USDA)"
          ],
          "body": [
            [
              "Pouched raw chicken",
              "145°F for 13 min · 147°F for 8.6 min"
            ]
          ]
        }
      ]
