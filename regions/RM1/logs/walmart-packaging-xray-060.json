              "short": "4. Weight"
            },
            {
              "id": "weight2",
              "label": "4. Weight 2",
              "type": "number",
              "unit": "oz",
              "short": "4. Weight"
            },
            {
              "id": "weight3",
              "label": "4. Weight 3",
              "type": "number",
              "unit": "oz",
              "short": "4. Weight"
            },
            {
              "id": "unitsPerCase",
              "label": "5. Units per case",
