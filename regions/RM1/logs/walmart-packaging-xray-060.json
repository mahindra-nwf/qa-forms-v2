{
  "name": "Packaging, Temperature, and X-Ray",
  "nameIf": {
    "field": "customer",
    "value": "Walmart",
    "name": "Walmart Packaging, Temperature, and X-Ray"
  },
  "code": "Log 060",
  "scope": "product",
  "category": "Packaging",
  "frequency": "Each production run · checks every 30 min",
  "description": "X-Ray check must be completed at the start of production, every hour (±15 minutes) of production, and at the end of production. If any monitoring fails, packaging must stop and all product from last passing inspection must be checked. Rejected packages will be rerun 3 times through the X-Ray. If all 3 reruns pass, product is released. If any of the 3 reruns are rejected again, number of packages are to be indicated in the comment and packages are to be given to QA for analysis.",
  "sections": [
    {
      "title": "Production",
      "fields": [
        {
          "id": "qaAuditor",
          "label": "QA auditor",
          "type": "text",
          "required": true
        },
        {
          "id": "location",
          "label": "Location",
          "type": "text",
          "prefill": "region"
        },
        {
          "id": "itemNumber",
          "label": "Item number",
          "type": "text",
          "prefill": "item"
        },
        {
          "id": "customer",
          "label": "Customer",
          "type": "text",
          "required": true,
          "prefill": "customer"
        },
        {
          "id": "datePacked",
          "label": "Date packed",
          "type": "date",
          "required": true,
          "default": "today"
        },
        {
          "id": "variety",
          "label": "Variety",
          "type": "text",
          "required": true,
          "prefill": "variety"
        },
        {
          "id": "masterCaseLot",
          "label": "Master case lot #",
          "type": "text",
          "required": true
        },
        {
          "id": "dateProduced",
          "label": "Date produced",
          "type": "date",
          "required": true
        },
        {
          "id": "fullCases",
          "label": "# Full cases",
          "type": "number"
        },
        {
          "id": "masterCaseExpiry",
          "label": "Master case expiration date",
          "type": "date"
        },
        {
          "id": "productionType",
          "label": "Select one",
          "type": "passfail",
          "options": [
            "Regular production",
            "Rework"
          ],
          "required": true
        },
        {
          "id": "reworkReason",
          "label": "Rework reason",
          "type": "text"
        }
      ]
    },
    {
      "title": "First article inspection",
      "fields": [
        {
          "id": "inspectionApproval",
          "label": "Inspection approval (initials)",
          "type": "text",
          "required": true,
          "hint": "The first article MUST be inspected for adherence to product specifications. First article inspections and approval MUST occur at the start of each new product."
        },
        {
          "id": "inspectionTime",
          "label": "Time",
          "type": "time",
          "required": true
        },
        {
          "id": "labelReview",
          "label": "Label review",
          "type": "checkbox",
          "checkLabel": "I verify the label used is correct in accordance with the Allergen Control Program (SOP 032)"
        },
        {
          "id": "trayTare",
          "label": "Tray tare weight (average of 5 trays, lids, and labels)",
          "type": "number",
          "unit": "oz"
        },
        {
          "id": "scaleWeight",
          "label": "Scale verification: calibrated weight",
          "type": "number",
          "unit": "g"
        },
        {
          "id": "scaleSerial",
          "label": "Scale serial #",
          "type": "text"
        },
        {
          "id": "pressurePopSeal",
          "label": "Pressure to pop seal",
          "type": "text"
        }
      ]
    },
    {
      "title": "Checks",
      "fields": [
        {
          "id": "checks",
          "label": "Checks",
          "type": "table",
          "rows": 1,
          "hint": "Tap + Full check every hour (all boxes: X-ray, label, 3 weights, seal, 3 × O2 and 3 × CO2, pallet temp, 2 label photos) and + Label check at the 30-minute marks in between (label inspection only; take 2 photos of the label with Take photo). Use Delete to remove a row added by mistake. Seal check: 3 consecutive trays for single meals, 2 for family meals. Obs. = Monthly direct observation; Pre-ship = Pre-shipment check (verify production documents have been reviewed, guarantees food safety, and release product).",
          "columns": [
            {
              "id": "time",
              "label": "1. Time",
              "type": "time",
              "span": 2
            },
            {
              "id": "xray",
